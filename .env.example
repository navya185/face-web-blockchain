# =====================================================================
# ENVIRONMENT CONFIGURATION FOR FACE SCAN - WEB SEARCH - BLOCKCHAIN PIPELINE
# =====================================================================

# --- Web & Social Search Engine API Keys (Optional - Fallback to Live Open Web Search) ---
# SerpAPI Key for Google Lens & Reverse Image Search (https://serpapi.com/)
SERPAPI_API_KEY=

# Google Custom Search Engine API (https://developers.google.com/custom-search/v1/overview)
GOOGLE_SEARCH_API_KEY=
GOOGLE_CSE_ID=

# Bing Search API (https://www.microsoft.com/en-us/bing/apis/bing-web-search-api)
BING_SEARCH_API_KEY=

# --- EVM Blockchain Configuration ---
# Local RPC Node Endpoint (Leave blank to use built-in Python-native EVM testnode out-of-the-box)
# Example local node: http://127.0.0.1:8545 (Anvil / Ganache / Hardhat)
RPC_URL=http://127.0.0.1:8545

# Private Key for Deployer/Submitter Account (Leave blank for default test account)
PRIVATE_KEY=

# Pre-deployed ContentVerifier Smart Contract Address (Optional)
CONTRACT_ADDRESS=
